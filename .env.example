# ─────────────────────────────────────────────────────────────────────────────
#  Firebase env vars (template — copiar a .env y llenar valores reales)
# ─────────────────────────────────────────────────────────────────────────────
#
#  ⚠️ NUNCA commitear el archivo .env real. Solo este template va al repo.
#  El archivo .env ya está protegido por .gitignore.
#
#  Para NutraLab-Geom (hosting estático):
#  - Las vars VITE_FIREBASE_* solo son necesarias si en runtime quieres
#    usar Firebase Auth, Firestore o Storage (no es el caso actual —
#    la app es 100% client-side y solo usa Firebase Hosting).
#  - El deploy vía CI/CD usa FIREBASE_TOKEN (token de service account,
#    NO web apiKey) que va como GitHub Secret, no en .env.
#
# ─────────────────────────────────────────────────────────────────────────────

# ID del proyecto Firebase (de Firebase Console → Project Settings)
VITE_FIREBASE_PROJECT_ID=

# Web API Key (de Firebase Console → Project Settings → General → Your apps)
# En apps web NO es secreto criptográfico, pero la convención es no
# commitearlo en texto plano. Va al bundle del cliente de todas formas.
VITE_FIREBASE_API_KEY=

# Auth domain (auto-derivado del project ID: <project-id>.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# Storage bucket (auto-derivado: <project-id>.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=

# Messaging Sender ID (de Firebase Console)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App ID (de Firebase Console → Project Settings → General → Your apps)
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
#  Variables NO-web (solo para CI/CD, NO van al bundle del cliente)
# ─────────────────────────────────────────────────────────────────────────────

# Token de Firebase CLI para deploy (se obtiene con: firebase login:ci)
# Va como GitHub Secret FIREBASE_TOKEN, NO en .env local.
# FIREBASE_TOKEN=